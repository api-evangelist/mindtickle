{
  "issuer": "https://app.mindtickle.com",
  "authorization_endpoint": "https://app.mindtickle.com/api/users/v1/oauth/authorize",
  "token_endpoint": "https://app.mindtickle.com/api/users/v1/oauth/token",
  "token_endpoint_auth_methods_supported": [
    "client_secret_post",
    "client_secret_basic",
    "private_key_jwt"
  ],
  "jwks_uri": "https://app.mindtickle.com/.well-known/jwks.json",
  "registration_endpoint": "https://app.mindtickle.com/api/users/v1/oauth/register",
  "scopes_supported": [
    "read:ai_roleplays",
    "read:calls",
    "read:copilot_chat",
    "read:rooms",
    "read:search",
    "write:ai_roleplays",
    "write:rooms"
  ],
  "response_types_supported": [
    "code"
  ],
  "grant_types_supported": [
    "authorization_code",
    "refresh_token",
    "client_credentials"
  ],
  "code_challenge_methods_supported": [
    "S256"
  ],
  "revocation_endpoint": "https://app.mindtickle.com/api/users/v1/oauth/revoke",
  "revocation_endpoint_auth_methods_supported": [
    "client_secret_post",
    "client_secret_basic"
  ],
  "introspection_endpoint": "https://app.mindtickle.com/api/users/v1/oauth/introspect",
  "introspection_endpoint_auth_methods_supported": [
    "client_secret_post",
    "client_secret_basic"
  ],
  "pushed_authorization_request_endpoint": "https://app.mindtickle.com/api/users/v1/oauth/par",
  "device_authorization_endpoint": "https://app.mindtickle.com/api/users/v1/oauth/device/code"
}